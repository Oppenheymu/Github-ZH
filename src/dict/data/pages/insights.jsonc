// 洞察模块：/owner/repo 下的洞察与工具类子页专属词条
// 覆盖 pulse / graphs / forks / security / projects 子树
// 注：用户名 / 仓库名 / GHSA 编号 / 公告标题属内容，不收录；
// 绝对日期（Sep 23, 2026 等）为全站动态格式，交全站规则处理；
// 图表轴刻度（Aug 2026 / Aug 10）与同月区间为洞察图表专属格式；
// 页标题中的仓库名与读屏属性里的用户名同样原样保留
{
	"$schema": "../../dict.schema.json",
	"route": "^/[^/]+/[^/]+/(pulse|graphs|forks|security|projects)",
	"entries": {
		// —— Pulse 动态页 ——
		"merged": "已合并",
		"Period:": "时间段：",
		"Open pull requests": "打开的拉取请求",
		"commits": "次提交",
		// —— 洞察侧栏 ——
		"Code frequency": "代码频率",
		"Community standards": "社区标准",
		// —— Forks 复刻列表 ——
		"Created": "创建于",
		"Recently updated": "最近更新",
		"Most starred": "星标最多",
		"Open issues": "打开的议题",
		"Starred": "已星标",
		"Sort:": "排序：",
		"Filter by period": "按时间段筛选",
		"Filter by repository type": "按仓库类型筛选",
		"Repository type:": "仓库类型：",
		"Archived repositories": "已归档仓库",
		"Forks of other forks": "其他复刻的复刻",
		"Inactive": "不活跃",
		"Repositories with push activity": "有推送活动的仓库",
		"Repositories with no push activity": "无推送活动的仓库",
		"Repositories with at least 1 star": "至少有 1 个星标的仓库",
		"Switch to tree view": "切换到树状视图",
		"Any repository that has not been created or\n    updated during this period will be excluded.": "在此期间未创建或未更新的仓库将被排除。",
		// —— graphs 图表（contributors 等）——
		"Contributions": "贡献",
		"Period": "时间段",
		"Last 3 months": "最近 3 个月",
		"Crunching the latest data, just for you. Hang tight…": "正在为你整理最新数据，请稍候…",
		"End of interactive chart.": "交互式图表结束。",
		"View as data table, Chart": "以数据表查看，图表",
		"Interactive chart": "交互式图表",
		"Interactive chart.": "交互式图表。",
		"Contributions per week to": "对以下分支的每周贡献：",
		", line counts have been omitted because commit count exceeds 10,000.": "（因提交数超过 10,000，行数统计已省略）",
		"Chart": "图表",
		"Chart options": "图表选项",
		"Customization settings": "自定义设置",
		"commit": "次提交",
		"'s Commits": " 的提交",
		"Weekly from": "每周，自",
		"over time": "随时间变化",
		// —— 图表读屏属性（属性只做整串精确匹配，不带规则）——
		"Axis zoom": "坐标轴缩放",
		"Start, percent": "起点，百分比",
		"End, percent": "终点，百分比",
		"Commits over time Axis zoom": "随时间变化的提交 坐标轴缩放",
		// —— Security 安全公告 ——
		"published": "已发布",
		"Published advisory": "已发布的安全公告",
		"GitHub Advisory Database": "GitHub 安全公告数据库",
		"High": "高危",
		"Moderate": "中危",
		"Critical": "严重",
		"Severity: high": "严重程度：高危",
		"Severity: moderate": "严重程度：中危",
		"Severity: critical": "严重程度：严重",
		"Learn more about advisories related to": "进一步了解与",
		"in the": "相关的安全公告，收录于",
		// —— Projects 项目 ——
		"Templates": "模板",
		"Repository projects": "仓库项目",
		"Filter projects by state": "按状态筛选项目",
		"Loading projects": "正在加载项目",
		"Search projects": "搜索项目",
		"Search by name…": "按名称搜索…",
		"updated": "更新于"
	},
	"rules": [
		// 复刻行 Created 后的裸时长与 Period 选项（无 ago 后缀，
		// 与 global 的「N units ago」规则区分）
		{
			"pattern": "^(\\d+) hours?$",
			"replacement": "$1 小时"
		},
		{ "pattern": "^(\\d+) days?$", "replacement": "$1 天" },
		{
			"pattern": "^(\\d+) weeks?$",
			"replacement": "$1 周"
		},
		{
			"pattern": "^(\\d+) months?$",
			"replacement": "$1 个月"
		},
		{
			"pattern": "^(\\d+) years?$",
			"replacement": "$1 年"
		},
		// 页标题与区块标题（Insights / 页面名译出，仓库名属内容原样保留）
		{
			"pattern": "^Insights: (.+)$",
			"replacement": "洞察：$1"
		},
		{
			"pattern": "^Contributors to (.+) \\u00B7 GitHub$",
			"replacement": "$1 的贡献者 · GitHub"
		},
		{
			"pattern": "^Security: (.+)$",
			"replacement": "安全：$1"
		},
		{
			"pattern": "^Forks \\u00B7 (.+) \\u00B7 GitHub$",
			"replacement": "复刻 · $1 · GitHub"
		},
		{
			"pattern": "^Projects \\u00B7 (.+) \\u00B7 GitHub$",
			"replacement": "项目 · $1 · GitHub"
		},
		{
			"pattern": "^Pulse \\u00B7 (.+) \\u00B7 GitHub$",
			"replacement": "活跃概览 · $1 · GitHub"
		},
		{
			"pattern": "^Overview \\u00B7 (.+) \\u00B7 GitHub$",
			"replacement": "概览 · $1 · GitHub"
		},
		// Pulse 周期区间（全月名同月区间；跨月区间不命中保持原文）
		{
			"pattern": "^January (\\d{1,2}), (\\d{4}) \\u2013 January (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 1 月 $1 日 – $4 日"
		},
		{
			"pattern": "^February (\\d{1,2}), (\\d{4}) \\u2013 February (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 2 月 $1 日 – $4 日"
		},
		{
			"pattern": "^March (\\d{1,2}), (\\d{4}) \\u2013 March (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 3 月 $1 日 – $4 日"
		},
		{
			"pattern": "^April (\\d{1,2}), (\\d{4}) \\u2013 April (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 4 月 $1 日 – $4 日"
		},
		{
			"pattern": "^May (\\d{1,2}), (\\d{4}) \\u2013 May (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 5 月 $1 日 – $4 日"
		},
		{
			"pattern": "^June (\\d{1,2}), (\\d{4}) \\u2013 June (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 6 月 $1 日 – $4 日"
		},
		{
			"pattern": "^July (\\d{1,2}), (\\d{4}) \\u2013 July (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 7 月 $1 日 – $4 日"
		},
		{
			"pattern": "^August (\\d{1,2}), (\\d{4}) \\u2013 August (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 8 月 $1 日 – $4 日"
		},
		{
			"pattern": "^September (\\d{1,2}), (\\d{4}) \\u2013 September (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 9 月 $1 日 – $4 日"
		},
		{
			"pattern": "^October (\\d{1,2}), (\\d{4}) \\u2013 October (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 10 月 $1 日 – $4 日"
		},
		{
			"pattern": "^November (\\d{1,2}), (\\d{4}) \\u2013 November (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 11 月 $1 日 – $4 日"
		},
		{
			"pattern": "^December (\\d{1,2}), (\\d{4}) \\u2013 December (\\d{1,2}), (\\d{4})$",
			"replacement": "$2 年 12 月 $1 日 – $4 日"
		},
		// 图表轴刻度：年月（Aug 2026 → 2026 年 8 月）
		{
			"pattern": "^Jan (\\d{4})$",
			"replacement": "$1 年 1 月"
		},
		{
			"pattern": "^Feb (\\d{4})$",
			"replacement": "$1 年 2 月"
		},
		{
			"pattern": "^Mar (\\d{4})$",
			"replacement": "$1 年 3 月"
		},
		{
			"pattern": "^Apr (\\d{4})$",
			"replacement": "$1 年 4 月"
		},
		{
			"pattern": "^May (\\d{4})$",
			"replacement": "$1 年 5 月"
		},
		{
			"pattern": "^Jun (\\d{4})$",
			"replacement": "$1 年 6 月"
		},
		{
			"pattern": "^Jul (\\d{4})$",
			"replacement": "$1 年 7 月"
		},
		{
			"pattern": "^Aug (\\d{4})$",
			"replacement": "$1 年 8 月"
		},
		{
			"pattern": "^Sep (\\d{4})$",
			"replacement": "$1 年 9 月"
		},
		{
			"pattern": "^Oct (\\d{4})$",
			"replacement": "$1 年 10 月"
		},
		{
			"pattern": "^Nov (\\d{4})$",
			"replacement": "$1 年 11 月"
		},
		{
			"pattern": "^Dec (\\d{4})$",
			"replacement": "$1 年 12 月"
		},
		// 图表轴刻度：月日（Aug 10 → 8 月 10 日）
		{
			"pattern": "^Jan (\\d{1,2})$",
			"replacement": "1 月 $1 日"
		},
		{
			"pattern": "^Feb (\\d{1,2})$",
			"replacement": "2 月 $1 日"
		},
		{
			"pattern": "^Mar (\\d{1,2})$",
			"replacement": "3 月 $1 日"
		},
		{
			"pattern": "^Apr (\\d{1,2})$",
			"replacement": "4 月 $1 日"
		},
		{
			"pattern": "^May (\\d{1,2})$",
			"replacement": "5 月 $1 日"
		},
		{
			"pattern": "^Jun (\\d{1,2})$",
			"replacement": "6 月 $1 日"
		},
		{
			"pattern": "^Jul (\\d{1,2})$",
			"replacement": "7 月 $1 日"
		},
		{
			"pattern": "^Aug (\\d{1,2})$",
			"replacement": "8 月 $1 日"
		},
		{
			"pattern": "^Sep (\\d{1,2})$",
			"replacement": "9 月 $1 日"
		},
		{
			"pattern": "^Oct (\\d{1,2})$",
			"replacement": "10 月 $1 日"
		},
		{
			"pattern": "^Nov (\\d{1,2})$",
			"replacement": "11 月 $1 日"
		},
		{
			"pattern": "^Dec (\\d{1,2})$",
			"replacement": "12 月 $1 日"
		},
		// Highcharts 图表无障碍描述（轴名随图表固定，直接译入句中；
		// 双空格键经引擎空白归一后按单空格匹配）
		{
			"pattern": "^The chart has (\\d+) X ax(?:is|es) displaying Time\\. Data ranges from (.+) to (.+)\\.$",
			"replacement": "图表有 $1 条 X 轴，显示时间。数据范围从 $2 到 $3。"
		},
		{
			"pattern": "^The chart has (\\d+) X axes displaying Time, and navigator-x-axis\\.$",
			"replacement": "图表有 $1 条 X 轴，显示时间与导航器 X 轴。"
		},
		{
			"pattern": "^The chart has (\\d+) Y ax(?:is|es) displaying Contributions\\. Data ranges from (-?[\\d.]+) to (-?[\\d.]+)\\.$",
			"replacement": "图表有 $1 条 Y 轴，显示贡献。数据范围从 $2 到 $3。"
		},
		{
			"pattern": "^The chart has (\\d+) Y axes displaying Contributions, and navigator-y-axis\\.$",
			"replacement": "图表有 $1 条 Y 轴，显示贡献与导航器 Y 轴。"
		},
		{
			"pattern": "^Combination chart with (\\d+) data series\\.$",
			"replacement": "包含 $1 个数据系列的组合图。"
		},
		// Pulse 统计缩写计数（1k → 1 千）
		{ "pattern": "^([\\d.]+)k$", "replacement": "$1 千" },
		// Highcharts 无障碍文案（数字随图表变化）
		{
			"pattern": "^Bar chart with (\\d+) bars?\\.$",
			"replacement": "包含 $1 根柱条的柱状图。"
		},
		{
			"pattern": "^Created with Highcharts ([\\d.]+)$",
			"replacement": "使用 Highcharts $1 创建"
		},
		{
			"pattern": "^Navigator (\\d+), series (\\d+) of (\\d+) with ([\\d,]+) data points\\. Y axis, (.+)\\. X axis, (.+)\\.$",
			"replacement": "导航器 $1，系列 $2/$3，共 $4 个数据点。Y 轴：$5。X 轴：$6。"
		}
	]
}
