					"pattern": "^March (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-dec",
					"pattern": "^March (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-jan",
					"pattern": "^April (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-feb",
					"pattern": "^April (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-mar",
					"pattern": "^April (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-may",
					"pattern": "^April (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-jun",
					"pattern": "^April (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-jul",
					"pattern": "^April (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-aug",
					"pattern": "^April (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
