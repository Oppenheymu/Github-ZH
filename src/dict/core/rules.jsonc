// 共享正则规则（运行时）：pattern 与语言无关，只有替换模板分语言——
// 模板在 locales/<语言>/rules.jsonc 里按 id 对应（缺 id = 该语言尚未翻译该规则，规则不生效）。
//
// 顺序即语义：pattern 对整段已 trim 文本 test，首条命中生效。模块分组顺序与
// core/modules.jsonc 一致（global 兜底在最后）；模块内顺序由本文件定。
// 规则不得带 flags 字段（g / y 的 lastIndex 会跨节点累积导致漏翻）。
// JSONC 转义：正则 \d 在此写作 \\d（写漏一层 Bun 直接报 Syntax Error，不会静默变义）。
{
	"$schema": "../types/dict.schema.json",
	"modules": [
		{
			"name": "pages/issues",
			"rules": [
				// 列表行归属与文档标题（仓库名保留原文）
				{
					"id": "issues/in-repo",
					"pattern": "^In ([^/]+\\/[^/]+);$"
				},
				{
					"id": "issues/page-title",
					"pattern": "^Issues \\u00B7 (.+) \\u00B7 GitHub$"
				},
				// 「opened on <日期>」日期段，月份缩写保留原文（与 search.jsonc 同款）
				{
					"id": "issues/on-date",
					"pattern": "^on ([A-Z][a-z]{2} \\d{1,2}, \\d{4})$"
				},
				// 列表行「N linked PRs」关联拉取请求计数（单复数折叠；
				// 仅覆盖文本节点，属性值不应用正则规则，见模块头注释）
				{
					"id": "issues/linked-prs-count",
					"pattern": "^(\\d+) linked PRs?$"
				}
			]
		},
		{
			"name": "pages/pulls",
			"rules": [
				// 合并横幅（计数可变）：wants to merge N commit(s) into <基线分支>
				{
					"id": "pulls/merge-commits-into",
					"pattern": "^wants to merge (\\d+) commits? into$"
				},
				// 折叠时间线与侧栏参与者计数
				{
					"id": "pulls/hidden-items-count",
					"pattern": "^(\\d+) hidden items?$"
				},
				{
					"id": "pulls/participants-count",
					"pattern": "^(\\d+) participants?$"
				},
				// 页面文档标题：列表页与详情页（仓库名 / PR 标题保留原文）
				{
					"id": "pulls/page-title",
					"pattern": "^Pull requests \\u00B7 (.+) \\u00B7 GitHub$"
				},
				{
					"id": "pulls/pull-request-title-with-number",
					"pattern": "^(?<title>.+) \\u00B7 Pull Request #(?<number>\\d+) \\u00B7 (?<repo>[^/]+\\/[^/]+) \\u00B7 GitHub$"
				},
				{
					"id": "pulls/pull-request-title-with-number-plain",
					"pattern": "^(?<title>.+) \\u00B7 Pull Request #(?<number>\\d+) \\u00B7 (?<repo>[^/]+\\/[^/]+)$"
				}
			]
		},
		{
			"name": "pages/settings",
			"rules": [
				// 导出数据的可用天数。实机节点边界：句号属于用户名链接节点，
				// 故本句所在文本节点的值形如 ".\n      Exports will be available for 7 days."，
				// pattern 必须容忍可选的前导 ". "（纯句号节点翻译不了，跳过即可）
				{
					"id": "settings/export-available",
					"pattern": "^[.]?\\s*Exports will be available for (\\d+) days?\\.$"
				},
				// 删除账号区块：「你的账户目前是以下组织的所有者：」这个句子节点不含清单
				// （清单是同级 <strong>），故冒号后允许为空；组织名保留原文
				{
					"id": "settings/owner-organizations",
					"pattern": "^Your account is currently an owner in these organizations:(?: (.+))?$"
				}
			]
		},
		{
			"name": "pages/settings-billing",
			"rules": [
				// 账单页（/settings/billing）的用量表格：说明句与时间范围常被拆成两个节点
				// （"Gross metered usage for " + 区间），区间本身又是动态的，故按月全展开：
				// 12 条同月 + 132 条跨月，与 insights/range-long-* 同一形态。之所以逐组合
				// 写死月份，是因为替换模板不支持函数映射——把英文月名捕获进模板，中文里
				// 就会渲染出 September（见 src/content/__tests__/settings-billing.test.ts）。
				//
				// 顺序即语义：同月的 12 条以月份字面量锚定，先吃掉「September 1 - September
				// 30, 2026」这类；跨月的 132 条各自写死起止月份，收尾的 (?:\\.)? 同时覆盖
				// 「裸区间」与「带句号」，故两类互不顶替。
				//
				// 另注意：裸区间必须排在 global 的 long-date-* 之前 —— 那些规则以 ^ 锚定
				// 但未以 $ 收尾，会给「September 1 - September 30, 2026」做部分替换，
				// 产出中英混合的残句。
				{
					"id": "settings/usage-range-same-month-jan",
					"pattern": "^January (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-feb",
					"pattern": "^February (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-mar",
					"pattern": "^March (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-apr",
					"pattern": "^April (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-may",
					"pattern": "^May (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-jun",
					"pattern": "^June (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-jul",
					"pattern": "^July (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-aug",
					"pattern": "^August (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-sep",
					"pattern": "^September (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-oct",
					"pattern": "^October (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-nov",
					"pattern": "^November (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-same-month-dec",
					"pattern": "^December (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-feb",
					"pattern": "^January (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-mar",
					"pattern": "^January (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-apr",
					"pattern": "^January (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-may",
					"pattern": "^January (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-jun",
					"pattern": "^January (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-jul",
					"pattern": "^January (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-aug",
					"pattern": "^January (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-sep",
					"pattern": "^January (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-oct",
					"pattern": "^January (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-nov",
					"pattern": "^January (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-jan-dec",
					"pattern": "^January (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-jan",
					"pattern": "^February (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-mar",
					"pattern": "^February (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-apr",
					"pattern": "^February (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-may",
					"pattern": "^February (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-jun",
					"pattern": "^February (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-jul",
					"pattern": "^February (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-aug",
					"pattern": "^February (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-sep",
					"pattern": "^February (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-oct",
					"pattern": "^February (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-nov",
					"pattern": "^February (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-feb-dec",
					"pattern": "^February (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-jan",
					"pattern": "^March (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-feb",
					"pattern": "^March (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-apr",
					"pattern": "^March (?<startDay>\\d{1,2}) - April (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-may",
					"pattern": "^March (?<startDay>\\d{1,2}) - May (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-jun",
					"pattern": "^March (?<startDay>\\d{1,2}) - June (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-jul",
					"pattern": "^March (?<startDay>\\d{1,2}) - July (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-aug",
					"pattern": "^March (?<startDay>\\d{1,2}) - August (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-sep",
					"pattern": "^March (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-mar-oct",
					"pattern": "^March (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
