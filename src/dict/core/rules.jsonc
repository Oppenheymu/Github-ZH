					"pattern": "^April (?<startDay>\\d{1,2}) - September (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-oct",
					"pattern": "^April (?<startDay>\\d{1,2}) - October (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-nov",
					"pattern": "^April (?<startDay>\\d{1,2}) - November (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-apr-dec",
					"pattern": "^April (?<startDay>\\d{1,2}) - December (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-may-jan",
					"pattern": "^May (?<startDay>\\d{1,2}) - January (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-may-feb",
					"pattern": "^May (?<startDay>\\d{1,2}) - February (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-may-mar",
					"pattern": "^May (?<startDay>\\d{1,2}) - March (?<endDay>\\d{1,2}), (?<year>\\d{4})(?:\\.)?$"
				},
				{
					"id": "settings/usage-range-cross-may-apr",
