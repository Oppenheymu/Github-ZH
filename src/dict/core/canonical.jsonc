// 规范键清单（仅门禁使用，不进 content 包）：当前 GitHub 真实渲染的英文原文全集，
// 按模块分组、顺序与 core/modules.jsonc 一致，分组注释与词条顺序沿用迁移前的词典。
//
// 三处用途：
// 1. 覆盖率分母——各语言缺哪些键，bun run check:dict 直接算得出来；
// 2. 拼错即报——某语言词条的键不在本清单里即报错（旧结构下拼错键只会静默不翻）；
// 3. 防循环门禁的「键集合」——任何语言的译文不得等于其中任何一个键。
{
	"$schema": "../dict.schema.json",
	"modules": [
		{
			"name": "pages/issues",
			"keys": [
				// —— 列表行元信息（状态徽标与打开时间）——
				"opened",
				"Status: Open.",
				"Status: Closed (completed).",
				"More information available below.",
				"new release",
				// —— 侧栏导航与保存视图 ——
				"Assigned to me",
				"Created by me",
				"Mentioned",
				"Recent activity",
				"Views",
				"Types",
				"Open Issues sidebar navigation",
				"Issues sidebar navigation",
				"Collapse sidebar",
				// —— 搜索与筛选 ——
				"Search Issues",
				"Suggestions",
				"Issue filters",
				"Filter all issues",
				"Filter by author",
				"Filter by milestones",
				"Filter by projects",
				"Filter by assignees",
				"Filter by issue type",
				"Filter by labels",
				", descending",
				// —— 列表排序菜单与新建入口（既有词条，恢复保留）——
				"Newest",
				"Oldest",
				"Most commented",
				"Least commented",
				"Recently updated",
				"Least recently updated",
				"New label",
				"New milestone",
				// —— 详情页操作按钮（既有词条，恢复保留）——
				"Close issue",
				"Reopen issue",
				"Submit new issue",
				"Assign yourself",
				// —— 置顶议题与创建限制 ——
				"Issue creation is restricted in this repository",
				"Drag and drop pinned issues list.",
				// —— 标签描述（筛选列表 / 悬停提示展示）——
				"Request for new features or functionality",
				"Issue identified by VS Code Team member as probable bug",
				"Issues found in a recent release of VS Code",
				"VS Code keybinding issues",
				"Editor column selection issues",
				"Code quality issues",
				"Editor basic functionality",
				"General VS Code workbench layout issues",
				"General terminal issues that don't fall under another label",
				"Issue identified as 'upstream' component related (exists outside of VS Code)",
				"Issue is under discussion for relevance, priority, approach",
				"Issues and items related to Electron",
				"Issues concerning extensions",
				"Issues with VS Code on Linux",
				"Native OS integration issues",
				"This is an upstream issue that has been reported upstream",
				"VS Code installation and upgrade system issues",
				"VS Code on Windows issues",
				"Explorer widget issues",
				"File glob engine",
				"Issue requires more information from poster",
				"VS Code configuration, settings",
