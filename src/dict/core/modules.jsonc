// 模块清单（运行时）：模块名 + 路由，顺序即优先级——具体页在前，global 兜底在最后。
//
// 为什么路由是语言无关的、只存一份：上游改版改的是「哪个路径下的哪些英文原文」，
// 与译成哪种语言无关。译文按模块放在 locales/<语言>/ 下，键集合不必跨语言相同
// （引擎未命中即保留英文，缺键 = 尚未翻译，不是错误）。
//
// 词条键的权威清单在 core/canonical.jsonc（覆盖率分母 + 拼错即报）；本文件只管路由。
{
	"$schema": "../types/dict.schema.json",
	"modules": [
		{
			"name": "pages/issues",
			"route": "^/[^/]+/[^/]+/issues"
		},
		{
			"name": "pages/pulls",
			"route": "^/[^/]+/[^/]+/pull"
		},
		{
			"name": "pages/settings",
			"route": "^/settings"
		},
		{
			"name": "pages/settings-billing",
			"route": "^/settings/billing"
		},
		{
			"name": "pages/repo-settings",
			"route": "^/[^/]+/[^/]+/settings"
		},
		{
			"name": "pages/actions",
			"route": "^/[^/]+/[^/]+/actions"
		},
		{
			"name": "pages/agents",
			"route": "^/[^/]+/[^/]+/agents"
		},
		{
			"name": "pages/dashboard",
			"route": "^/$"
		},
		{
			"name": "pages/commits",
			"route": "^/[^/]+/[^/]+/(commits?|tags|branches|compare)"
		},
		{
			"name": "pages/discussions",
			"route": "^/[^/]+/[^/]+/discussions"
		},
		{
			"name": "pages/wiki",
			"route": "^/[^/]+/[^/]+/wiki"
		},
		{
			"name": "pages/insights",
			"route": "^/[^/]+/[^/]+/(pulse|graphs|forks|security|projects)"
		},
		{
			"name": "pages/search",
			"route": "^/(search|topics)"
		},
		{
			"name": "pages/marketing",
			"route": "^/(features|pricing)"
		},
		// 用户主页是**单段路径**（/octocat）。GitHub 的保留顶层路径不是用户名，不排除它们
		// 的话这一模块会把整包个人主页词条（Edit profile / Block or report / Contribution
		// activity…）注入 /search、/features、/pricing、/notifications 等页面——与 pages/repo
		// 注入 /settings 是同一类越界，只是注入量更大。新增保留路径要同步这里与 pages/repo。
		{
			"name": "pages/profile",
			"route": "^/(?!(?:settings|account|billing|sessions|login|logout|signup|join|search|explore|topics|trending|collections|marketplace|apps|sponsors|codespaces|notifications|dashboard|issues|pulls|discussions|stars|watching|new|organizations|orgs|users|enterprises|features|pricing|site|security|team|events|about|contact)(?:/|$))[^/]+$"
		},
		// 仓库页：/owner/repo 及其任意子路径。保留顶层路径必须排除——`^/[^/]+/[^/]+` 会命中
		// /settings/profile、/settings/appearance 等**用户账号设置页**，把 84 条仓库专属词条
		// （Code / Clone / Blame / Raw / Release…）注入进去（实测在设置页真的会生效）。
		// 保留清单与 pages/profile 保持同一份；新增保留路径要同步。
		{
			"name": "pages/repo",
			"route": "^/(?!(?:settings|account|billing|sessions|login|logout|signup|join|search|explore|topics|trending|collections|marketplace|apps|sponsors|codespaces|notifications|dashboard|issues|pulls|discussions|stars|watching|new|organizations|orgs|users|enterprises|features|pricing|site|security|team|events|about|contact)(?:/|$))[^/]+/[^/]+"
		},
		{
			"name": "global",
			"route": "^/"
		}
	]
}
